# Aplicação Next.js — copie para .env.local e preencha com as credenciais do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=https://dylipirsdywzitppzjjh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privada: Supabase > Settings > API Keys > chave service_role.
# Nunca prefixar com NEXT_PUBLIC_ e nunca commitar o .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Nesta branch, Baileys é o transporte para testes locais.
# Para voltar temporariamente à integração Meta, altere para meta.
WHATSAPP_TRANSPORT=baileys

# Credenciais Meta ficam preservadas para rollback, mas não são usadas no modo Baileys.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

BUSINESS_TIMEZONE=America/Campo_Grande
CRON_SECRET=
