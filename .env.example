# Públicas: usadas pelo site
NEXT_PUBLIC_SUPABASE_URL=https://dylipirsdywzitppzjjh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privada: Supabase > Settings > API Keys > chave service_role legada
# Nunca prefixar com NEXT_PUBLIC_ e nunca commitar o .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Meta for Developers > aplicativo > WhatsApp > Configuração da API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versão suportada mostrada no exemplo de chamada da Meta, no formato vNN.N
WHATSAPP_API_VERSION=
# App settings > Basic > App secret (não é o token de acesso)
WHATSAPP_APP_SECRET=
# Crie uma senha aleatória e use a mesma no cadastro do webhook na Meta
WHATSAPP_VERIFY_TOKEN=

# Fuso do estabelecimento; ajuste se o negócio não estiver em Mato Grosso do Sul
BUSINESS_TIMEZONE=America/Campo_Grande
# Senha aleatória para o endpoint de reenvio; configurar também no agendador
CRON_SECRET=
