[Unit]
Description=WhatsApp Baileys Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whatsapp-worker
Group=whatsapp-worker
WorkingDirectory=/opt/whatsapp-agendamento/worker
EnvironmentFile=/etc/whatsapp-worker.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/whatsapp-agendamento

[Install]
WantedBy=multi-user.target
